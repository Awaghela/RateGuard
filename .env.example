# Copy this file to .env and fill it in. Never commit .env.

# The public hostname that points at your server (an A record to its IP address).
DOMAIN=rateguard.example.com

# Secrets. Generate each with:  openssl rand -hex 32
ADMIN_TOKEN=
POSTGRES_PASSWORD=

# What to do when Redis is unreachable: false = reject requests (503), true = allow them.
FAIL_OPEN=false

# Policy for clients that have none saved.
DEFAULT_CAPACITY=100
DEFAULT_REFILL_PER_SEC=50
